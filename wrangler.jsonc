{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keep this name. Workers Builds deploys this repository to the existing
  // rockfort-metals Worker. Do not rename it, and do not point this file at
  // rockfort-metal-coating or rockfort-website.
  "name": "rockfort-metals",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "vars": {
    "LEAD_FROM": "quotes@rockfortindustries.com"
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "482173",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
